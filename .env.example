# ==============================================================================
# CONFIGURACIÓN DE PROVEEDORES DE IA GRATUITOS (ZERO-COST AI TIER)
# ==============================================================================

# 1. Groq Cloud (Free Tier - 30 RPM, ultra-rápido Llama 3.3 70B)
# Obtén tu API key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_gratuita_aqui

# 2. Google AI Studio (Gemini Free Tier - 15 RPM, 1M tokens/min)
# Obtén tu API key gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_tu_clave_gratuita_aqui

# 3. Ollama Local (100% Offline, ilimitado, sin cuotas)
# Descarga e instala desde: https://ollama.com
# Ejecuta en tu terminal: ollama run llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ==============================================================================
# CONFIGURACIÓN DE CONCESIONARIO Y CANALES
# ==============================================================================
PORT=3000
NODE_ENV=development
