  "description": "Enterprise Multi-Channel AI Chat Automation Core for BuyaCar Colombia with NestJS, Playwright, SSOT Catalog and Zero-Token AI Fallback",
  "author": "Principal Software Architect",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
